layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        children
    }
    tab name="logs" {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane command="ssh" {
                    args "-t" "alda.svr.jeiang.dev" "journalctl -f"
                }
                pane command="ssh" {
                    args "-t" "vida.svr.jeiang.dev" "journalctl -f"
                }
            }
            pane split_direction="horizontal" {
                pane command="ssh" {
                    args "-t" "zantark.svr.jeiang.dev" "journalctl -f"
                }
                pane command="ssh" {
                    args "-t" "peria.svr.jeiang.dev" "journalctl -f"
                }
            }
            pane command="ssh" {
                args "-t" "artemis.jeiang.vpn" "journalctl -f"
            }
        }
    }
}
