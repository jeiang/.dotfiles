layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
        children
    }
    tab name="logs" {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane command="ssh" {
                    args "-t" "node1.jeiang.dev" "journalctl -f"
                }
                pane command="ssh" {
                    args "-t" "node2.jeiang.dev" "journalctl -f"
                }
            }
            pane split_direction="horizontal" {
                pane command="ssh" {
                    args "-t" "node3.jeiang.dev" "journalctl -f"
                }
                pane command="ssh" {
                    args "-t" "node4.jeiang.dev" "journalctl -f"
                }
            }
            pane command="ssh" {
                args "-t" "artemis.jeiang.vpn" "journalctl -f"
            }
        }
    }
}
