layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
        children
    }
    tab name="alda" {
        pane command="ssh" {
            args "alda.svr.jeiang.dev"
        }
    }
    tab name="vida" {
        pane command="ssh" {
            args "vida.svr.jeiang.dev"
        }
    }
    tab name="zantark" {
        pane command="ssh" {
            args "zantark.svr.jeiang.dev"
        }
    }
    tab name="peria" {
        pane command="ssh" {
            args "peria.svr.jeiang.dev"
        }
    }
}
