{
  inputs,
  lib,
  self,
  ...
}: let
  shardRegex = "(^|/)secrets(\\.[^./]+)?\\.(yaml|env|ini|json)$";

  # Every shard is encrypted to all of these.
  adminKeys = [
    {
      name = "aidanp";
      key = "age1yy2uxasknys578edlnepcxug2j37ntep0tudfv9nr7qqx6d9ws3sack68y";
    }
    {
      name = "aidanp_yubikey_a";
      key = "age1yubikey1q2kwazjvk2nahlsjmkqya7mng9x3lj7qjl3pzrdwyh76nfjy5tx9yh28r5k";
    }
    {
      name = "aidanp_yubikey_b";
      key = "age1yubikey1qtdc4zk5vh49smwk40q4229mqxaywuz7qwutwfm7pww6z9zxjpa2utzw4aw";
    }
    {
      name = "aidanp_se";
      key = "age1se1qtaeyd7cgq6czap5vgy6uj7nqjaefvvjsl73e9cej2865q6ddq56k83mkz3";
    }
  ];

  # ssh-to-age of each host's ed25519 host key.
  hostKeys = {
    alda = "age1fexn9r8huh294w3hmyst605fndjagyg7e3s23aqfedlqrqnn24rq5lvgr7";
    artemis = "age1fm8meecmpus97y9ra9gjdk08g8njran6fv4jxnr0zegpfd89a9esayj39c";
    peria = "age1a80m5fpv387njdmg63q6vvkavahepdkx7zq4gjjkg62x3lme4f7q9s5c66";
    ricklent = "age1fx090xwlhgzjr9nhescyx2q3pgfw470qqqxmadzlwy4xducgtdjq43hlg6";
    vida = "age1f9t7ktuy3hny3lju3692mqx35mrc0wrfrl8mtelyeecc4lydcu0snxtm23";
    zakkart = "age1dy6m8ldy4pnqhleqhkqtej3nxvvkyu9dflzjkctrxxwl2ddj5sjqzc4j3p";
    zantark = "age1yc37qpvazdtfswa38057e73sh523q0exj75qqahzgax6kqaxeqmsq2wx9t";
  };

  # Stored data only; no host reads them.
  adminShards = ["modules/sops/secrets.admin.yaml"];

  root = "${toString self}/";
  shardPath = host: file: let
    path = lib.removePrefix root (toString file);
  in
    if path == toString file
    then throw "${host}: sops shard ${path} is outside the flake"
    else if builtins.match ".*${shardRegex}" path == null
    then throw "${host}: sops shard ${path} does not match lib.sopsShardRegex"
    else path;

  # shard -> hosts that declare a secret from it
  readers = lib.zipAttrs (lib.concatLists (lib.mapAttrsToList (host: cfg:
    map (shard: {${shard} = host;})
    (lib.unique (map (secret: shardPath host secret.sopsFile) (lib.attrValues cfg.config.sops.secrets))))
  (self.nixosConfigurations // self.darwinConfigurations)));

  hostAnchor = host:
    if hostKeys ? ${host}
    then "server_${host}"
    else throw "${host} reads sops secrets but has no age key in modules/sops/default.nix";

  rule = shard:
    [
      "  - path_regex: ${lib.escapeRegex shard}$"
      "    key_groups:"
      "    - age:"
    ]
    ++ map (anchor: "      - *${anchor}") (map (k: "user_${k.name}") adminKeys ++ map hostAnchor (readers.${shard} or []))
    ++ [""];

  sopsConfig = lib.concatLines (
    [
      "# Generated by `just sops-config` from the shards each host's sops.secrets read; do not edit."
      "keys:"
    ]
    ++ map (k: "  - &user_${k.name} ${k.key}") adminKeys
    ++ lib.mapAttrsToList (host: key: "  - &server_${host} ${key}") hostKeys
    ++ ["" "creation_rules:"]
    ++ lib.init (lib.concatMap rule (lib.sort lib.lessThan (adminShards ++ lib.attrNames readers)))
  );
in {
  flake.lib = {
    sopsShardRegex = shardRegex;
    inherit sopsConfig;
  };

  perSystem = {pkgs, ...}: {
    checks.sops-config = pkgs.runCommand "sops-config" {} ''
      diff -u ${../../.sops.yaml} ${pkgs.writeText "sops.yaml" sopsConfig} || {
        echo ".sops.yaml is stale; regenerate it with: just sops-config" >&2
        exit 1
      }
      touch $out
    '';
  };

  nixos.modules.base = {
    imports = [inputs.sops-nix.nixosModules.sops];
    sops.useSystemdActivation = true;
  };

  darwin.modules.base.imports = [inputs.sops-nix.darwinModules.sops];
}
