+// --- AVX-512 VNNI compatibility shims ------------------------------------
+//
+// `_mm512_dpbusd_epi32` / `_mm512_dpwssd_epi32` cannot be compiled by a rustc
+// whose bundled `stdarch` emits the LLVM 22 form of `llvm.x86.avx512.vpdpbusd
+// .512` / `.vpdpwssd.512` (`<64 x i8>` / `<32 x i16>` operands) while rustc is
+// linked against LLVM 21 (`<16 x i32>` operands).  These shims compute the same
+// results with plain AVX-512BW integer ops, which every affected LLVM lowers
+// correctly.  Both are exact, not approximations: the inputs here stay far
+// inside the i16 range (|c_u × q| <= 255 × 64), so no intermediate saturates.
+// They cost a handful of extra uops per iteration versus the single fused
+// VPDPBUSD/VPDPWSSD.
+
+/// Non-saturating `VPDPBUSD`: `src[lane] += sum over the 4 bytes of
+/// (u8)a x (i8)b`, wrapping in i32.
+///
+/// # Safety
+/// CPU must support `avx512f` and `avx512bw`.
+#[inline]
+#[target_feature(enable = "avx512f,avx512bw")]
+unsafe fn dpbusd_epi32_compat(
+    src: core::arch::x86_64::__m512i,
+    a: core::arch::x86_64::__m512i,
+    b: core::arch::x86_64::__m512i,
+) -> core::arch::x86_64::__m512i {
+    use core::arch::x86_64::*;
+
+    unsafe {
+        // Split each i16 into its two bytes, zero-extending the unsigned
+        // operand and sign-extending the signed one.
+        let a_even = _mm512_and_si512(a, _mm512_set1_epi16(0x00FF));
+        let a_odd = _mm512_srli_epi16(a, 8);
+        let b_even = _mm512_srai_epi16(_mm512_slli_epi16(b, 8), 8);
+        let b_odd = _mm512_srai_epi16(b, 8);
+
+        // |a| <= 255, |b| <= 128, so every product fits an i16 exactly.
+        let p_even = _mm512_mullo_epi16(a_even, b_even);
+        let p_odd = _mm512_mullo_epi16(a_odd, b_odd);
+
+        // `madd_epi16` with a ones vector folds the two i16 lanes of each i32
+        // lane together: even gives bytes 0 and 2, odd gives bytes 1 and 3.
+        let ones = _mm512_set1_epi16(1);
+        _mm512_add_epi32(
+            src,
+            _mm512_add_epi32(
+                _mm512_madd_epi16(p_even, ones),
+                _mm512_madd_epi16(p_odd, ones),
+            ),
+        )
+    }
+}
+
+/// Non-saturating `VPDPWSSD`: `src[lane] += a[2·lane]·b[2·lane] +
+/// a[2·lane+1]·b[2·lane+1]`, every operand signed i16.
+///
+/// # Safety
+/// CPU must support `avx512f` and `avx512bw`.
+#[inline]
+#[target_feature(enable = "avx512f,avx512bw")]
+unsafe fn dpwssd_epi32_compat(
+    src: core::arch::x86_64::__m512i,
+    a: core::arch::x86_64::__m512i,
+    b: core::arch::x86_64::__m512i,
+) -> core::arch::x86_64::__m512i {
+    use core::arch::x86_64::*;
 
+    // `PMADDWD` is exactly the multiply-add half of VPDPWSSD.
+    unsafe { _mm512_add_epi32(src, _mm512_madd_epi16(a, b)) }
+}
+
