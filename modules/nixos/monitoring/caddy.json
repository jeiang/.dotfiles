            },
            "overrides": []
          },
          "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "footer": {
              "show": false,
              "reducer": ["sum"],
              "countRows": false,
              "fields": ""
            },
            "sortBy": [
              {
                "displayName": "requests",
                "desc": true
              }
            ]
          },
          "targets": [
            {
              "refId": "A",
